# Copy to .env (not committed) to change how `npm run dev` behaves.

# mock = in-browser simulator (default), api = the ASP.NET Core backend
VITE_DATA_SOURCE=mock

# Simulator only: how much of the rig exists
#   zone-a   = Zone A only (matches the bench now)
#   two-zone = Zones A and B
#   full     = three zones plus trunk/return sensors (final build)
VITE_SIM_STAGE=zone-a

# Leave empty: the backend serves this app, and `npm run dev` proxies to localhost:5000
VITE_API_URL=
